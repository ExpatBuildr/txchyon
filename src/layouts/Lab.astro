---
// Shared shell for the Txchyon site (dark/light theme, IBM Plex, simple header and footer).
// The homepage (src/pages/index.astro) carries its own copy of these styles; keep the two in sync.
import { socials } from "@/lib/socials";

interface Props {
  title: string; // full <title>, e.g. "About | Txchyon"
  description: string;
  canonical: string; // path, e.g. "/blog"
  image?: string;
  prev?: string; // path of previous page in a series
  next?: string; // path of next page in a series
  noindex?: boolean;
  ogType?: "website" | "article";
  published?: string; // ISO date, articles only
  modified?: string;
  jsonld?: Record<string, unknown>;
  ads?: boolean; // load the AdSense script (articles only)
}

const {
  title,
  description,
  canonical,
  image = "/images/og-txchyon.png",
  prev,
  next,
  noindex = false,
  ogType = "website",
  published,
  modified,
  jsonld,
  ads = false,
} = Astro.props;
const site = "https://txchyon.com";
const url = canonical.startsWith("http") ? canonical : site + canonical;
const path = Astro.url.pathname;
const inBlog = path === "/blog" || path.startsWith("/blog/");
const imageUrl = image.startsWith("http") ? image : site + (image.startsWith("/") ? "" : "/") + image;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="ExpatBuildr" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={url} />
    {prev && <link rel="prev" href={site + prev} />}
    {next && <link rel="next" href={site + next} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Txchyon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@txchyon" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Txchyon" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <meta name="google-adsense-account" content="ca-pub-4395640740127630" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W77T47Y58P"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-W77T47Y58P');
    </script>

    <!-- Ahrefs Analytics -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="BM9NrhHESqRca7xP0Vuqeg" async></script>

    {ads && (
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4395640740127630" crossorigin="anonymous"></script>
    )}

    <script is:inline>
      // Same storage key the rest of the site uses.
      try {
        var t = localStorage.getItem("txchyon-theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>

    <style is:global>
      :root,
      :root[data-theme="dark"] {
        --bg: #0b0d12;
        --card: #141824;
        --tx: #e8ecf5;
        --mut: #a1a8b6;
        --line: #222a3b;
        --on: #ffd23f;
        --on-tx: #111111;
        --acc: #ffd23f;
        --acc-line: #4a3f10;
        --logo: none;
      }
      :root[data-theme="light"] {
        --bg: #fafafa;
        --card: #ffffff;
        --tx: #15171c;
        --mut: #565d6b;
        --line: #e2e4e9;
        --on: #15171c;
        --on-tx: #fafafa;
        --acc: #15171c;
        --acc-line: #c9ccd3;
        --logo: brightness(0);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--tx);
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        min-height: 100vh;
      }
      a { color: inherit; }
      a:hover { opacity: 0.75; }
      a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
      .wrap { max-width: 760px; margin: 0 auto; padding: 0 24px; }
      .lab-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 28px 0; border-bottom: 1px solid var(--line); }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
      .brand img { width: 32px; height: 32px; object-fit: contain; filter: var(--logo); }
      .brand span { font-weight: 700; font-size: 20px; letter-spacing: -0.3px; }
      .lab-header nav { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; font-size: 15px; }
      .lab-header nav a { text-decoration: none; color: var(--mut); }
      .lab-header nav a[aria-current="page"] { color: var(--tx); }
      button { font: inherit; cursor: pointer; }
      .theme-btn { font-size: 14px; color: var(--tx); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; min-height: 40px; }
      .lab-section { padding: 48px 0; display: flex; flex-direction: column; gap: 24px; }
      .lab-section.first { padding: 72px 0 40px; gap: 20px; }
      .lab-section.tight { padding-top: 8px; }
      .lab-wrap h1 { font-weight: 600; font-size: clamp(34px, 5vw, 44px); letter-spacing: -1.2px; line-height: 1.1; margin: 0; }
      .lab-wrap h2 { margin: 0; font-size: 26px; font-weight: 700; letter-spacing: -0.4px; }
      .lab-wrap p { margin: 0; }
      .lead { font-size: 17px; max-width: 520px; color: var(--mut); margin: 0; }
      .mut { color: var(--mut); }
      .small { font-size: 14px; color: var(--mut); }
      .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
      .tag { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; color: var(--acc); border: 1px solid var(--acc-line); border-radius: 999px; padding: 4px 12px; text-decoration: none; white-space: nowrap; }

      /* Category filter: plain text, no pills */
      .chips { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 8px; }
      .chips a, .chip { font-family: inherit; font-size: 15px; color: var(--mut); border: 0; border-radius: 0; padding: 6px 0; border-bottom: 1px solid transparent; background: none; }
      .chips a:hover { color: var(--tx); opacity: 1; }
      .chips a[aria-current="page"] { color: var(--tx); background: none; border-bottom-color: var(--acc); }
      [hidden] { display: none !important; }

      /* Month labels */
      .month { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--mut); opacity: .75; padding: 36px 0 12px; border-bottom: 1px solid var(--line); }

      /* Rows: date | title + excerpt | category */
      .entry { display: grid; grid-template-columns: 84px 1fr auto; gap: 4px 24px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
      .entry:hover { opacity: 1; }
      .entry .date { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; color: var(--mut); opacity: .8; }
      .entry b { display: block; font-weight: 500; font-size: 18px; line-height: 1.35; letter-spacing: -0.2px; }
      .entry:hover b { text-decoration: underline; text-decoration-color: var(--acc); text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
      .entry .desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 6px; font-size: 15px; line-height: 1.55; color: var(--mut); }
      .entry .cat { font-size: 13px; color: var(--mut); opacity: .8; white-space: nowrap; }
      @media (max-width: 600px) { .entry { grid-template-columns: 1fr; gap: 6px; } .entry .cat { display: none; } .wrap { padding: 0 16px; } }

      /* Pagination: plain text */
      .pager { display: flex; justify-content: space-between; align-items: center; padding: 36px 0 8px; font-size: 15px; color: var(--mut); }
      .pager a, .pager .off, .pager .cur { display: inline; min-width: 0; min-height: 0; padding: 0; border: 0; border-radius: 0; background: none; font-weight: 400; color: inherit; }
      .pager a:hover { color: var(--tx); opacity: 1; }
      .pager .off { opacity: .35; }
      .pager .count { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; opacity: .8; }

      /* cards, forms, buttons */
      .card { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 20px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
      .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 0; border-radius: 999px; background: var(--on); color: var(--on-tx); font-weight: 600; text-decoration: none; }
      .btn.ghost { background: transparent; color: var(--tx); border: 1px solid var(--line); }
      .field { display: flex; flex-direction: column; gap: 6px; }
      .field label { font-size: 14px; color: var(--mut); }
      .input { width: 100%; padding: 12px 14px; background: var(--card); color: var(--tx); border: 1px solid var(--line); border-radius: 10px; font: inherit; }
      textarea.input { min-height: 140px; resize: vertical; }

      /* long-form text: articles, legal pages, about */
      .prose { font-size: 18px; line-height: 1.75; overflow-wrap: anywhere; }
      .lab-wrap .prose p { margin: 1em 0; }
      .prose h2 { margin: 2.2em 0 0.5em; font-size: 26px; line-height: 1.25; }
      .prose h3 { margin: 1.8em 0 0.4em; font-size: 21px; line-height: 1.3; font-weight: 700; }
      .prose h4 { margin: 1.5em 0 0.3em; font-size: 18px; font-weight: 700; }
      .prose a { color: var(--acc); text-decoration: underline; text-underline-offset: 3px; }
      .prose ul, .prose ol { padding-left: 1.4em; margin: 1em 0; }
      .prose li { margin: 0.35em 0; }
      .prose blockquote { margin: 1.4em 0; padding: 0.2em 0 0.2em 1.1em; border-left: 3px solid var(--line); color: var(--mut); }
      .prose code { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 0.88em; background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; }
      .prose pre { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; line-height: 1.5; }
      .prose pre code { background: none; border: 0; padding: 0; }
      .prose img { max-width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); }
      .prose table { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.4em 0; font-size: 16px; }
      .prose th, .prose td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
      .prose th { font-weight: 600; }
      .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
      .prose iframe, .prose video { max-width: 100%; }

      /* ads (articles only) */
      .ad-container { margin: 32px 0; text-align: center; overflow: hidden; }
      .ad-container .ad-disclosure { margin-top: 6px; font-size: 12px; color: var(--mut); opacity: 0.7; }

      /* footer */
      .icons { display: flex; align-items: center; gap: 4px; }
      .icons a { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 999px; color: var(--mut); }
      .icons svg { width: 20px; height: 20px; fill: currentColor; }
      .lab-footer { padding: 32px 0 48px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 14px; color: var(--mut); }
      .lab-footer .legal { max-width: 520px; display: flex; flex-direction: column; gap: 10px; }
      .lab-footer .legal nav { display: flex; flex-wrap: wrap; gap: 6px 16px; }
      .lab-footer .foot-left { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
      .lab-footer .brand img { width: 24px; height: 24px; }
      .lab-footer .brand span { font-size: 16px; color: var(--tx); }
      .lab-footer .icons { margin-left: -10px; }
      @media (max-width: 520px) { .lab-section.first { padding: 48px 0 32px; } .prose { font-size: 17px; } }
    </style>
  </head>
  <body>
    <div class="wrap lab-wrap">
      <header class="lab-header">
        <a href="/" class="brand">
          <img src="/images/landing/logo.png" alt="" width="32" height="32" />
          <span>Txchyon</span>
        </a>
        <nav aria-label="Main">
          <a href="/#software">Software</a>
          <a href="/#notes">Lab notes</a>
          <a href="/blog" aria-current={inBlog ? "page" : undefined}>Blog</a>
          <span class="icons">
            {socials.filter((s) => s.header).map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} /></svg>
              </a>
            ))}
          </span>
          <button type="button" class="theme-btn" id="themeBtn" aria-label="Switch light or dark mode">Light mode</button>
        </nav>
      </header>

      <slot />

      <footer class="lab-footer">
        <div class="foot-left">
          <a href="/" class="brand">
            <img src="/images/landing/logo.png" alt="" width="24" height="24" />
            <span>Txchyon</span>
          </a>
          <span>© 2026 Txchyon</span>
          <div class="icons">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} /></svg>
              </a>
            ))}
          </div>
          <span>Built by <a href="https://x.com/expatbuilder" target="_blank" rel="noopener noreferrer">ExpatBuildr</a></span>
        </div>
        <div class="legal">
          <nav aria-label="Site">
            <a href="/about">About</a>
            <a href="/tools">Tools</a>
            <a href="/newsletter">Newsletter</a>
            <a href="/contact">Contact</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/disclaimer">Disclaimer</a>
            <a href="/rss.xml">RSS</a>
          </nav>
          <span>
            Research and software only. Not investment advice. Nothing on this site is for sale, and we don't give signals or manage money. Some
            older articles contain affiliate links; see the <a href="/disclaimer">disclaimer</a>.
          </span>
        </div>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("themeBtn");
        function label() {
          btn.textContent = root.getAttribute("data-theme") === "dark" ? "Light mode" : "Dark mode";
        }
        label();
        btn.addEventListener("click", function () {
          var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("txchyon-theme", next); } catch (e) {}
          label();
        });
      })();
    </script>
  </body>
</html>
