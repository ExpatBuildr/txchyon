---
// AdSense unit for article pages. The AdSense script itself is loaded by Lab.astro (ads prop).
// Old version archived at src/pages/_archive/old-design/GoogleAd.astro.txt
const { pathname } = Astro.url;
const { position = "middle" } = Astro.props;

const shouldShowAds = pathname.startsWith("/blog/");

const adSlots = {
  top: "8178043657",
  middle: "3779138804",
  bottom: "5551880317",
};
const slotId = adSlots[position] || adSlots.middle;
---

{shouldShowAds && (
  <div class="ad-container" data-ad-position={position}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-4395640740127630"
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
    <div class="ad-disclosure">Advertisement</div>
  </div>
)}
