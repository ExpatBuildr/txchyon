---
// Blog listing in the homepage style. Used by /blog (page 1) and /blog/page/N.
import { getCollection } from "astro:content";

interface Props {
  page: number;
}

const { page } = Astro.props;
const pageSize = 12; // keep in sync with getStaticPaths in src/pages/blog/page/[page].astro

const categoryLabels: Record<string, string> = {
  "getting-started": "Getting started",
  "security-privacy": "Security & privacy",
  "trading-investing": "Trading",
  "defi-yield": "DeFi & yield",
  "airdrop-farming": "Airdrops",
  "infrastructure-tech": "Infrastructure",
  "tools-automation": "Tools",
  "research-analysis": "Research",
  "regulatory-tax": "Regulation & tax",
  "portfolio-management": "Portfolio",
  "prediction-markets": "Prediction markets",
  "alpha-insider": "Alpha",
  "web3-gaming-metaverse": "Web3 gaming",
};
const label = (c: string) => categoryLabels[c] ?? c;

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const totalPages = Math.ceil(posts.length / pageSize);
const pagePosts = posts.slice((page - 1) * pageSize, page * pageSize);

const counts: Record<string, number> = {};
for (const p of posts) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
const categories = Object.entries(counts).sort((a, b) => b[1] - a[1]);

const fmtMonth = (d: Date | string) =>
  new Date(d).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const fmtDay = (d: Date | string) =>
  new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });

const pageHref = (n: number) => (n === 1 ? "/blog" : `/blog/page/${n}`);
---

<section class="lab-section first">
  <h1>Blog</h1>
  <p class="lead">
    Guides on crypto trading, DeFi, airdrops, security and tax. {posts.length} articles, newest first.
  </p>
  <div class="chips" aria-label="Categories">
    {categories.map(([slug, n]) => (
      <a href={`/categories/${slug}`}>{label(slug)} · {n}</a>
    ))}
  </div>
</section>

<section class="lab-section tight">
  <div>
    {pagePosts.map((p, idx) => {
      const month = fmtMonth(p.data.date);
      const showMonth = idx === 0 || month !== fmtMonth(pagePosts[idx - 1].data.date);
      return (
        <Fragment>
          {showMonth && <div class="month">{month}</div>}
          <a class="entry" href={`/blog/${p.slug}`}>
            <span class="date">{fmtDay(p.data.date)}</span>
            <span>
              <b>{p.data.title}</b>
              {p.data.description && <span class="desc">{p.data.description}</span>}
            </span>
            <span class="cat">{label(p.data.category)}</span>
          </a>
        </Fragment>
      );
    })}
  </div>

  {totalPages > 1 && (
    <nav class="pager" aria-label="Blog pages">
      {page > 1 ? (
        <a href={pageHref(page - 1)} rel="prev">← Newer</a>
      ) : (
        <span></span>
      )}
      <span class="count">Page {page} of {totalPages}</span>
      {page < totalPages ? (
        <a href={pageHref(page + 1)} rel="next">Older →</a>
      ) : (
        <span></span>
      )}
    </nav>
  )}
</section>
