---
import { CATEGORY_HIERARCHY } from '@/lib/categories';
import config from '@/config/config.json';
// Define your footer links in a clean structure
const footerLinks = {
  explore: {
    title: 'Explore',
    links: [
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog' },
    ]
  },
  resources: {
    title: 'Resources',
    links: [
      { name: 'Toolkit', url: '/tools' },
      { name: 'Newsletter', url: '/newsletter' },
      { name: 'Getting Started', url: '/categories/getting-started' },
      { name: 'Airdrop Farming', url: '/categories/airdrop-farming' },
    ]
  }
};

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/ExpatBuildr', d: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12' },
  { name: 'X', href: 'https://x.com/txchyon', d: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  { name: 'YouTube', href: 'https://www.youtube.com/@Txchyon', d: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
];

const currentYear = new Date().getFullYear();

// Check if we're on home page for newsletter
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
---
<footer class="border-t dark:border-gray-800 border-gray-200 py-12">
  <div class="container mx-auto px-4">
    
    {/* Main Footer Content */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      
      {/* Brand Column - Takes 1 column */}
      <div>
        <a href="/" class="flex items-center gap-3 mb-6">
          <img
            src={`${config.site.base_url}/images/logo.png`}
            alt={config.site.title}
            class="w-12 h-12 rounded-lg object-cover"
          />
          <span class="text-2xl font-bold dark:text-white text-gray-900">
            {config.site.title}
          </span>
        </a>
        <p class="dark:text-gray-400 text-gray-600 text-sm mb-6">
          Premium DeFi education that should cost thousands... but we're giving it away free.
        </p>
        
        {/* Social Icons - This replaces the Connect section */}
        <div class="flex items-center gap-4 mb-4">
          {socialLinks.map((s) => (
            <a href={s.href}
               target="_blank"
               rel="noopener noreferrer"
               aria-label={s.name}
               title={s.name}
               class="dark:text-gray-400 text-gray-600 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.d} /></svg>
            </a>
          ))}
          <a href="/rss.xml"
             class="dark:text-gray-400 text-gray-600 hover:text-orange-500 dark:hover:text-orange-400 transition-colors"
             title="RSS Feed">
            <span class="text-xl">📡 RSS</span>
          </a>
        </div>
        
        {/* Contact link under social icons */}
        <a href="/contact" 
           class="dark:text-gray-400 text-gray-600 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm">
          📧 Contact Us
        </a>
      </div>
      
      {/* Footer Link Columns - 3 columns for Services, Resources, Learn */}
      {Object.entries(footerLinks).map(([key, section]) => (
        <div key={key}>
          <h3 class="text-lg font-bold dark:text-white text-gray-900 mb-4">
            {section.title}
          </h3>
          <ul class="space-y-3">
            {section.links.map(link => (
              <li>
                <a 
                  href={link.url}
                  class="dark:text-gray-400 text-gray-600 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm"
                  {link.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}    
    {/* Divider */}
    <div class="border-t dark:border-gray-800 border-gray-200 my-8"></div>
    
    {/* Bottom Bar */}
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      {/* Copyright & Links */}
      <div class="text-center md:text-left">
        <p class="dark:text-gray-500 text-gray-500 text-sm">
          © {currentYear} {config.site.title}. All content is free to share under{' '}
          <a href="https://creativecommons.org/licenses/by/4.0/" 
             target="_blank" 
             class="text-blue-600 dark:text-blue-400 hover:underline">
            CC BY 4.0
          </a>.
        </p>
        <p class="dark:text-gray-500 text-gray-500 text-sm mt-1">
          Built by
          <a href="https://x.com/expatbuilder"
             target="_blank"
             rel="noopener noreferrer"
             class="text-blue-600 dark:text-blue-400 hover:underline">ExpatBuildr</a>
        </p>
      </div>

      {/* Legal Links */}
      <div class="flex flex-wrap justify-center gap-4 md:gap-6">
        <a href="/privacy" class="dark:text-gray-500 text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 text-sm transition-colors">
          Privacy Policy
        </a>
        <a href="/terms" class="dark:text-gray-500 text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 text-sm transition-colors">
          Terms of Service
        </a>
        <a href="/disclaimer" class="dark:text-gray-500 text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 text-sm transition-colors">
          Disclaimer
        </a>
        <a href="/contact" class="dark:text-gray-500 text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 text-sm transition-colors">
          Contact
        </a>
      </div>
    </div>
    
    {/* Important Notice */}
    <div class="mt-8 pt-6 border-t dark:border-gray-800 border-gray-200">
      <p class="dark:text-gray-600 text-gray-500 text-xs text-center">
        ⚠️ <strong>Not financial advice:</strong> All content is educational. DeFi involves risk. 
        Always do your own research and never invest more than you can afford to lose.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Smooth hover effects */
  footer a {
    transition: all 0.2s ease;
  }
</style>