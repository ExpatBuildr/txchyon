---
// /contact. Old version: src/pages/_archive/old-design/contact.astro.txt
import Lab from "@/layouts/Lab.astro";
import config from "@/config/config.json";

const { contact_form_action } = config.params;
const { email } = config.contactinfo;
---

<Lab
  title="Contact | Txchyon"
  description="Get in touch with Txchyon for questions, feedback or collaboration."
  canonical="/contact"
>
  <section class="lab-section first">
    <h1>Contact</h1>
    <p class="lead">Questions, feedback or ideas? Send a message or email <a href={`mailto:${email}`}>{email}</a>.</p>
  </section>

  <section class="lab-section tight">
    <form class="contact-form" method="POST" action={contact_form_action}>
      <div class="field">
        <label for="name">Name</label>
        <input class="input" id="name" name="name" type="text" required />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" name="email" type="email" required />
      </div>
      <div class="field">
        <label for="subject">Subject</label>
        <input class="input" id="subject" name="subject" type="text" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea class="input" id="message" name="message" rows="5" required></textarea>
      </div>
      <button class="btn" type="submit">Send message</button>
    </form>
  </section>
</Lab>

<style>
  .contact-form { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
  .contact-form .btn { align-self: flex-start; }
</style>
