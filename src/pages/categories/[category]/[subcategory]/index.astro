---
// /categories/{category}/{subcategory}. Old version: src/pages/_archive/old-design/categories-subcategory.astro.txt
import { getCollection } from "astro:content";
import Lab from "@/layouts/Lab.astro";
import { CATEGORY_HIERARCHY } from "@/lib/categories";

export async function getStaticPaths() {
  const paths = [];
  for (const [category, c] of Object.entries(CATEGORY_HIERARCHY) as [string, any][]) {
    for (const subcategory of Object.keys(c.subcategories ?? {})) {
      paths.push({ params: { category, subcategory } });
    }
  }
  return paths;
}

const { category, subcategory } = Astro.params;
const cat: any = CATEGORY_HIERARCHY[category as string];
const subName: string = cat.subcategories[subcategory as string] ?? (subcategory as string);

const posts = (
  await getCollection("posts", ({ data }) => !data.draft && data.category === category && data.subcategory === subcategory)
).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const fmt = (x: Date | string) =>
  new Date(x).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Lab
  title={`${subName}, ${cat.name} | Txchyon`}
  description={`${subName}: ${posts.length} ${posts.length === 1 ? "article" : "articles"} in ${cat.name} from the Txchyon lab.`}
  canonical={`/categories/${category}/${subcategory}`}
  noindex={posts.length === 0}
>
  <section class="lab-section first">
    <p class="small mono"><a href="/categories">Categories</a> / <a href={`/categories/${category}`}>{cat.name}</a> /</p>
    <h1>{subName}</h1>
  </section>

  <section class="lab-section tight">
    {posts.length === 0 ? (
      <p class="mut">No articles here yet. <a href={`/categories/${category}`}>Back to {cat.name}</a>.</p>
    ) : (
      <div>
        {posts.map((p) => (
          <a class="entry" href={`/blog/${p.slug}`}>
            <b>{p.data.title}</b>
            <span class="desc">{p.data.description}</span>
            <span class="meta">{fmt(p.data.date)}</span>
          </a>
        ))}
      </div>
    )}
  </section>
</Lab>
