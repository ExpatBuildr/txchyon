---
// /categories/{category}. Old version: src/pages/_archive/old-design/categories-category.astro.txt
import { getCollection } from "astro:content";
import Lab from "@/layouts/Lab.astro";
import { CATEGORY_HIERARCHY } from "@/lib/categories";

export async function getStaticPaths() {
  return Object.keys(CATEGORY_HIERARCHY).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const data: any = CATEGORY_HIERARCHY[category as string];

const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category === category)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const subs = Object.entries(data.subcategories ?? {})
  .map(([slug, name]) => ({ slug, name: name as string, count: posts.filter((p) => p.data.subcategory === slug).length }))
  .filter((s) => s.count > 0);

const fmt = (x: Date | string) =>
  new Date(x).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Lab
  title={`${data.name} | Txchyon`}
  description={`${data.description}. ${posts.length} ${posts.length === 1 ? "article" : "articles"} from the Txchyon lab.`}
  canonical={`/categories/${category}`}
  noindex={posts.length === 0}
>
  <section class="lab-section first">
    <p class="small mono"><a href="/categories">Categories</a> /</p>
    <h1>{data.name}</h1>
    <p class="lead">{data.description}</p>
    {subs.length > 0 && (
      <div class="chips" aria-label="Subcategories">
        {subs.map((s) => <a href={`/categories/${category}/${s.slug}`}>{s.name} · {s.count}</a>)}
      </div>
    )}
  </section>

  <section class="lab-section tight">
    {posts.length === 0 ? (
      <p class="mut">No articles in this category yet. <a href="/blog">Browse the blog</a>.</p>
    ) : (
      <div>
        {posts.map((p) => (
          <a class="entry" href={`/blog/${p.slug}`}>
            <b>{p.data.title}</b>
            <span class="desc">{p.data.description}</span>
            <span class="meta">{fmt(p.data.date)}</span>
          </a>
        ))}
      </div>
    )}
  </section>
</Lab>
