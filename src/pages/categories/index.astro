---
// /categories. Old version: src/pages/_archive/old-design/categories-index.astro.txt
import { getCollection } from "astro:content";
import Lab from "@/layouts/Lab.astro";
import { CATEGORY_HIERARCHY } from "@/lib/categories";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const counts: Record<string, number> = {};
for (const p of posts) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;

const categories = Object.entries(CATEGORY_HIERARCHY)
  .map(([slug, c]: [string, any]) => ({ slug, name: c.name, description: c.description, count: counts[slug] ?? 0 }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);
---

<Lab
  title="Categories | Txchyon"
  description="Browse Txchyon's crypto guides by topic: getting started, security, trading, DeFi, airdrops, tax and more."
  canonical="/categories"
>
  <section class="lab-section first">
    <h1>Categories</h1>
    <p class="lead">{posts.length} articles across {categories.length} topics.</p>
  </section>

  <section class="lab-section tight">
    <div>
      {categories.map((c) => (
        <a class="entry" href={`/categories/${c.slug}`}>
          <b>{c.name}</b>
          <span class="desc">{c.description}</span>
          <span class="meta">{c.count} {c.count === 1 ? "article" : "articles"}</span>
        </a>
      ))}
    </div>
  </section>
</Lab>
