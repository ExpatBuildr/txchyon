---
// /blog/page/N (N >= 2). Old version archived at src/pages/_archive/blog-page-[page].astro.txt
import { getCollection } from "astro:content";
import Lab from "@/layouts/Lab.astro";
import BlogListing from "@/components/BlogListing.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const pageSize = 12; // keep in sync with BlogListing.astro
  const totalPages = Math.ceil(posts.length / pageSize);

  // Page 1 is /blog
  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    paths.push({ params: { page: page.toString() }, props: { page, totalPages } });
  }
  return paths;
}

const { page, totalPages } = Astro.props;
const prev = page === 2 ? "/blog" : `/blog/page/${page - 1}`;
const next = page < totalPages ? `/blog/page/${page + 1}` : undefined;
---

<Lab
  title={`Blog, page ${page} | Txchyon`}
  description={`Guides on crypto trading, DeFi, airdrops, security and tax from the Txchyon lab. Page ${page} of ${totalPages}.`}
  canonical={`/blog/page/${page}`}
  prev={prev}
  next={next}
>
  <BlogListing page={page} />
</Lab>
