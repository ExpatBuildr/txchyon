---
// Article page, /blog/{category}/{slug}. Old version: src/pages/_archive/old-design/blog-slug.astro.txt
import { getCollection, render } from "astro:content";
import Lab from "@/layouts/Lab.astro";
import GoogleAd from "@/components/ads/GoogleAd.astro";
import { slugify, humanize } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const categoryLabels: Record<string, string> = {
  "getting-started": "Getting started",
  "security-privacy": "Security & privacy",
  "trading-investing": "Trading",
  "defi-yield": "DeFi & yield",
  "airdrop-farming": "Airdrops",
  "infrastructure-tech": "Infrastructure",
  "tools-automation": "Tools",
  "research-analysis": "Research",
  "regulatory-tax": "Regulation & tax",
  "portfolio-management": "Portfolio",
  "prediction-markets": "Prediction markets",
  "alpha-insider": "Alpha",
  "web3-gaming-metaverse": "Web3 gaming",
};
const label = (c: string) => categoryLabels[c] ?? humanize(c);

const fmt = (x: Date | string) =>
  new Date(x).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const minutes = Math.max(1, Math.round((post.body?.match(/\S+/g)?.length ?? 0) / 220));

const site = "https://txchyon.com";
const path = `/blog/${post.slug}`;
const pageTitle = `${d.meta_title || d.title} | Txchyon`;
const image = d.image && typeof d.image === "string" && d.image.trim() ? d.image : "/images/og-txchyon.png";
const imageAbs = image.startsWith("http") ? image : site + (image.startsWith("/") ? "" : "/") + image;
const published = new Date(d.date).toISOString();
const modified = d.updatedDate ? new Date(d.updatedDate).toISOString() : undefined;
const showUpdated = !!d.updatedDate && fmt(d.updatedDate) !== fmt(d.date);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  image: imageAbs,
  datePublished: published,
  dateModified: modified ?? published,
  mainEntityOfPage: site + path,
  author: { "@type": "Person", name: "ExpatBuildr", url: "https://x.com/expatbuilder" },
  publisher: {
    "@type": "Organization",
    name: "Txchyon",
    logo: { "@type": "ImageObject", url: site + "/images/landing/logo.png" },
  },
};

const all = await getCollection("posts", ({ data }) => !data.draft);
const more = all
  .filter((p) => p.slug !== post.slug && p.data.category === d.category)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const url = site + path;
const enc = encodeURIComponent;
const share = [
  { name: "X", href: `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(d.title)}` },
  { name: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
  { name: "Telegram", href: `https://t.me/share/url?url=${enc(url)}&text=${enc(d.title)}` },
  { name: "WhatsApp", href: `https://wa.me/?text=${enc(d.title + " " + url)}` },
];
---

<Lab
  title={pageTitle}
  description={d.description}
  canonical={d.canonical || path}
  image={image}
  noindex={!!d.noindex}
  ogType="article"
  published={published}
  modified={modified}
  jsonld={jsonld}
  ads={true}
>
  <article>
    <header class="lab-section first article-head">
      <a class="tag" href={`/categories/${d.category}`}>{label(d.category)}</a>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="small mono">
        By <a href="/authors/galaxy">ExpatBuildr</a> · {fmt(d.date)}{showUpdated ? ` · updated ${fmt(d.updatedDate)}` : ""} · {minutes} min read
      </p>
    </header>

    <div class="top-ad"><GoogleAd position="top" /></div>

    {d.image && <img class="hero" src={d.image} alt={d.title} loading="lazy" />}

    <div class="prose">
      <Content />
    </div>

    <GoogleAd position="middle" />

    <section class="card signup" aria-labelledby="signup-title">
      <h2 id="signup-title">Get new articles by email</h2>
      <p class="mut">Free, and you can unsubscribe any time.</p>
      <div class="embed">
        <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
        <iframe
          src="https://subscribe-forms.beehiiv.com/cc63cad9-7786-4f32-badd-628ad1226266"
          class="beehiiv-embed"
          data-test-id="beehiiv-embed"
          frameborder="0"
          scrolling="no"
          style="width: 500px; height: 420px; border: none; border-radius: 12px; max-width: 100%;"
          loading="lazy"
          title="Subscribe to the newsletter"
        ></iframe>
      </div>
      <noscript>
        <p class="small"><a href="https://txchyon.beehiiv.com/subscribe" target="_blank" rel="noopener">Subscribe to the newsletter</a></p>
      </noscript>
    </section>

    <footer class="after">
      {d.tags && d.tags.length > 0 && (
        <div class="chips" aria-label="Tags">
          {d.tags.map((t: string) => <a href={`/tags/${slugify(t)}`}>#{humanize(t)}</a>)}
        </div>
      )}
      <div class="chips" aria-label="Share">
        <span class="chip">Share</span>
        {share.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a>)}
      </div>
      <p class="small">
        Not investment advice. Some links may be affiliate links; see the <a href="/disclaimer">disclaimer</a>. Ads help keep these articles free.
      </p>
    </footer>

    <GoogleAd position="bottom" />
  </article>

  {more.length > 0 && (
    <section class="lab-section tight">
      <h2>More in {label(d.category)}</h2>
      <div>
        {more.map((p) => (
          <a class="entry" href={`/blog/${p.slug}`}>
            <b>{p.data.title}</b>
            <span class="desc">{p.data.description}</span>
            <span class="meta">{fmt(p.data.date)}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Lab>

<style>
  .article-head { padding-bottom: 24px; }
  .article-head .tag { align-self: flex-start; }
  .article-head .lead { font-size: 18px; }
  .hero { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); margin: 8px 0 8px; }
  .top-ad { display: none; }
  @media (min-width: 1024px) { .top-ad { display: block; } }
  .signup { margin: 48px 0 24px; display: flex; flex-direction: column; gap: 12px; align-items: center; text-align: center; }
  .signup .embed { width: 100%; display: flex; justify-content: center; }
  .after { display: flex; flex-direction: column; gap: 16px; padding: 24px 0; border-top: 1px solid var(--line); }
</style>
