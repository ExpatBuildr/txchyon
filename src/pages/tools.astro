---

<Lab
  title="Tools | Txchyon"
  description="The exchanges, wallets and apps we use for crypto research and trading, with a plain note on which links are referral links."
  canonical="/tools"
>
  <section class="lab-section first">
    <h1>Tools</h1>
    <p class="lead">The exchanges, wallets and apps we use for crypto research and trading.</p>
    <p class="small">
      Many links here are referral links. Using them never costs you extra, and commissions help keep this site free. This is not
      financial advice; see the <a href="/disclaimer">disclaimer</a>.
    </p>
  </section>

  <section class="lab-section tight">
    <div class="chips" id="category-tabs" role="group" aria-label="Filter by category">
      {tabs.map((t) => (
        <button type="button" class="chipbtn" data-category={t.id} aria-pressed={t.id === "all" ? "true" : "false"}>{t.label}</button>
      ))}
    </div>
    <input class="input" type="search" id="tool-search" placeholder="Search tools" aria-label="Search tools" />

    <div class="grid" id="tools-grid">
      {tools.map((tool) => (
        <div class="card tool-card" data-category={tool.category} data-status={tool.status} data-name={tool.name.toLowerCase()}>
          <div class="tool-top">
            <b>{tool.name}</b>
            <span class="chip">{tool.type}</span>
          </div>
          <p class="mut tool-desc">{tool.description}</p>
          <div class="tool-bottom">
            <span class="small">{tool.url !== "#" ? tool.bonus : ""}</span>
            {tool.url !== "#" ? (
              <a class="btn ghost" href={tool.url} target="_blank" rel="noopener noreferrer">Visit</a>
            ) : (
              <span class="small">Coming soon</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <p class="small">
      Suggest a tool? <a href="/contact">Get in touch</a>. See also <a href="/categories/tools-automation">our tool articles</a>.
    </p>
  </section>
</Lab>

<style>
  .chipbtn { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; color: var(--mut); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; min-height: 36px; }
  .chipbtn[aria-pressed="true"] { background: var(--on); color: var(--on-tx); border-color: var(--on); }
  .tool-card { display: flex; flex-direction: column; gap: 10px; }
  .tool-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .tool-top b { font-size: 18px; font-weight: 600; }
  .tool-desc { font-size: 15px; flex: 1; }
  .tool-bottom { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .tool-bottom .btn { min-height: 36px; padding: 0 16px; font-size: 14px; }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".chipbtn");
  const cards = document.querySelectorAll<HTMLElement>(".tool-card");
  const search = document.getElementById("tool-search") as HTMLInputElement | null;
  let category = "all";

  function apply() {
    const q = (search?.value ?? "").toLowerCase();
    cards.forEach((card) => {
      const okCat = category === "all" || card.dataset.category === category;
      const okText = !q || (card.textContent ?? "").toLowerCase().includes(q);
      card.style.display = okCat && okText ? "" : "none";
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      category = tab.dataset.category ?? "all";
      tabs.forEach((t) => t.setAttribute("aria-pressed", t === tab ? "true" : "false"));
      apply();
    });
  });
  search?.addEventListener("input", apply);
</script>
