---
// Txchyon minimal landing page. Standalone page (does not use Base.astro).
import { getCollection } from "astro:content";

const published = (await getCollection("posts", ({ data }) => !data.draft)).length;

// Curated, all published articles (URLs verified in the site audit).
const bullPosts = [
  { title: "Front-running and anti-bot protection", tag: "Security", url: "/blog/alpha-insider/front-running-anti-bot" },
  { title: "Gas and execution optimization", tag: "DeFi", url: "/blog/alpha-insider/gas-execution-optimization" },
  { title: "Reading liquidity pools", tag: "DeFi", url: "/blog/alpha-insider/liquidity-pool-analysis-alpha" },
  { title: "Spotting new DEX pairs early", tag: "Research", url: "/blog/alpha-insider/spot-new-dex-pairs" },
  { title: "Capital allocation", tag: "Portfolio", url: "/blog/alpha-insider/capital-allocation-scaling" },
  { title: "Airdrop disqualification risks", tag: "Airdrops", url: "/blog/airdrop-farming/airdrop-disqualification-risks" },
];
const bearPosts = [
  {
    title: "Liquidity is Contracting: The 2026 Macro Defense Playbook",
    tag: "Macro liquidity",
    url: "/bear/blog/macro-liquidity/monetary-policy/liquidity-is-contracting",
  },
];
const screens = [
  { src: "/images/landing/app-home.webp", alt: "Txchyon app home screen with balance and net worth chart", title: "Home", text: "Real balance, net worth over time, paper results." },
  { src: "/images/landing/app-teach.webp", alt: "Teach mode screen showing a setup and its outcome", title: "Teach", text: "Label a setup, then see what really happened." },
  { src: "/images/landing/app-mark.webp", alt: "Mark my trades chart with buy, stop and sell lines", title: "Mark my trades", text: "Tap your buy, stop and sell on real candles." },
];
const notes = [
  { date: "Oct 2026", text: "First real-data backtest: the 15-minute strategy lost money over 90 days (31 trades). The 4-hour version was slightly positive but only broke even under a stress test." },
  { date: "Oct 2026", text: "Now calibrating the setup detector against real trades I marked by hand, before changing any rules." },
  { date: "Next", text: "Several weeks of paper trading on live prices. Results get posted here, wins and losses alike." },
];
const title = "Txchyon — a small crypto trading research lab";
const description = "A small lab that researches crypto trading strategies and builds the software to test them. Nothing here is for sale.";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://txchyon.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://txchyon.com/" />
    <meta property="og:image" content="https://txchyon.com/images/og-txchyon.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/images/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W77T47Y58P"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-W77T47Y58P');
    </script>

    <!-- Ahrefs Analytics -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="BM9NrhHESqRca7xP0Vuqeg" async></script>

    <script is:inline>
      // Same storage key the rest of the site already uses.
      try {
        var t = localStorage.getItem("txchyon-theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>

    <style>
      :root,
      :root[data-theme="dark"] {
        --bg: #0b0d12;
        --card: #141824;
        --tx: #e8ecf5;
        --mut: #a1a8b6;
        --line: #222a3b;
        --on: #ffd23f;
        --on-tx: #111111;
        --acc: #ffd23f;
        --acc-line: #4a3f10;
        --logo: none;
      }
      :root[data-theme="light"] {
        --bg: #fafafa;
        --card: #ffffff;
        --tx: #15171c;
        --mut: #565d6b;
        --line: #e2e4e9;
        --on: #15171c;
        --on-tx: #fafafa;
        --acc: #15171c;
        --acc-line: #c9ccd3;
        --logo: brightness(0);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--tx);
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        min-height: 100vh;
      }
      a { color: inherit; }
      a:hover { opacity: 0.75; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
      .wrap { max-width: 880px; margin: 0 auto; padding: 0 24px; }
      header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 28px 0; border-bottom: 1px solid var(--line); }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
      .brand img { width: 32px; height: 32px; object-fit: contain; filter: var(--logo); }
      .brand span { font-weight: 700; font-size: 20px; letter-spacing: -0.3px; }
      nav { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; font-size: 15px; }
      nav a { text-decoration: none; color: var(--mut); }
      button { font: inherit; cursor: pointer; }
      .theme-btn { font-size: 14px; color: var(--tx); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; min-height: 40px; }
      section { padding: 48px 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 24px; }
      #top { border-top: 0; padding: 88px 0 64px; gap: 20px; }
      h1 { margin: 0; font-size: clamp(36px, 5.5vw, 56px); line-height: 1.1; font-weight: 700; letter-spacing: -1.2px; text-wrap: balance; }
      h2 { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }
      p { margin: 0; }
      .lead { max-width: 620px; font-size: 19px; color: var(--mut); }
      .mut { color: var(--mut); }
      .row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }
      .tag { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; color: var(--acc); border: 1px solid var(--acc-line); border-radius: 999px; padding: 4px 12px; }
      .screens { display: flex; flex-wrap: wrap; gap: 20px; }
      figure { margin: 0; flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
      figure img { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; object-position: top; border-radius: 14px; border: 1px solid var(--line); background: var(--card); }
      figcaption { font-size: 15px; }
      figcaption b { font-weight: 600; }
      ul.bullets { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; color: var(--mut); }
      ul.bullets span { color: var(--tx); }
      .small { font-size: 13px; color: var(--mut); }
      .note { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .note .d { flex: 0 0 110px; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; color: var(--mut); padding-top: 3px; }
      .note .t { flex: 1 1 420px; min-width: 0; }
      .blog-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
      .seg { display: flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; gap: 3px; }
      .seg button { border: 0; border-radius: 999px; padding: 8px 18px; min-height: 40px; font-size: 14px; background: transparent; color: var(--mut); }
      .seg button[aria-pressed="true"] { background: var(--on); color: var(--on-tx); }
      .post { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 16px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
      .post b { font-weight: 500; }
      .post span { font-size: 14px; color: var(--mut); }
      .all { font-weight: 600; color: var(--acc); text-decoration: underline; text-underline-offset: 4px; align-self: flex-start; }
      [hidden] { display: none !important; }
      footer { padding: 32px 0 48px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--mut); }
      footer .legal { max-width: 520px; }
      @media (max-width: 520px) { #top { padding: 56px 0 40px; } }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a href="#top" class="brand">
          <img src="/images/landing/logo.png" alt="" width="32" height="32" />
          <span>Txchyon</span>
        </a>
        <nav aria-label="Main">
          <a href="#software">Software</a>
          <a href="#notes">Lab notes</a>
          <a href="#blog">Blog</a>
          <button type="button" class="theme-btn" id="themeBtn" aria-label="Switch light or dark mode">Light mode</button>
        </nav>
      </header>

      <section id="top">
        <h1>A small lab that researches crypto trading strategies and builds the software to test them.</h1>
        <p class="lead">
          We test ideas on real market data, keep notes on what works and what doesn't, and build apps and learning tools
          along the way. Nothing here is for sale.
        </p>
      </section>

      <section id="software">
        <div class="row">
          <h2>The Txchyon app</h2>
          <span class="tag">In development · paper trading only</span>
        </div>
        <p class="mut" style="max-width: 640px">
          A rules-based spot trading bot with a phone app to watch and control it. It runs on paper first, with real prices
          and real fees, so every idea is tested before any money is at risk.
        </p>
        <div class="screens">
          {screens.map((s) => (
            <figure>
              <img src={s.src} alt={s.alt} loading="lazy" />
              <figcaption><b>{s.title}</b><br /><span class="mut">{s.text}</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="small">Screens show sample data.</p>
        <ul class="bullets">
          <li><span>Bot:</span> buys support bounces and trend pullbacks on SOL, ETH and BTC, with a stop on every trade.</li>
          <li><span>Learning tools:</span> Teach mode compares your calls with the bot's rules; Mark my trades checks whether the bot would have found your own trades. An AI analyst is planned.</li>
          <li><span>Alerts:</span> phone alerts the moment a setup appears, loud enough to wake you.</li>
        </ul>
      </section>

      <section id="notes">
        <h2>Lab notes</h2>
        <div>
          {notes.map((n) => (
            <div class="note"><span class="d">{n.date}</span><span class="t">{n.text}</span></div>
          ))}
        </div>
      </section>

      <section id="blog">
        <div class="blog-head">
          <h2>From the blog</h2>
          <div class="seg" role="group" aria-label="Market type">
            <button type="button" id="bullBtn" aria-pressed="true">Bull</button>
            <button type="button" id="bearBtn" aria-pressed="false">Bear</button>
          </div>
        </div>
        <p class="mut" id="blogIntro">Guides for rising markets: DeFi, airdrops, security and finding opportunities early.</p>
        <div id="bullList">
          {bullPosts.map((p) => (
            <a class="post" href={p.url}><b>{p.title}</b><span>{p.tag}</span></a>
          ))}
        </div>
        <div id="bearList" hidden>
          {bearPosts.map((p) => (
            <a class="post" href={p.url}><b>{p.title}</b><span>{p.tag}</span></a>
          ))}
        </div>
        <a class="all" id="allLink" href="/blog">Read all {published} articles</a>
      </section>

      <footer>
        <span>© 2026 Txchyon</span>
        <span class="legal">
          Research and software only. Not investment advice. Nothing on this site is for sale, and we don't give signals or manage money. Some
          older articles contain affiliate links; see the <a href="/disclaimer">disclaimer</a>.
        </span>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var themeBtn = document.getElementById("themeBtn");
        function label() {
          themeBtn.textContent = root.getAttribute("data-theme") === "dark" ? "Light mode" : "Dark mode";
        }
        label();
        themeBtn.addEventListener("click", function () {
          var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("txchyon-theme", next); } catch (e) {}
          label();
        });

        var bullBtn = document.getElementById("bullBtn");
        var bearBtn = document.getElementById("bearBtn");
        var bullList = document.getElementById("bullList");
        var bearList = document.getElementById("bearList");
        var intro = document.getElementById("blogIntro");
        var all = document.getElementById("allLink");
        var bullAll = all.textContent, bullHref = all.getAttribute("href");
        var bullIntro = intro.textContent;
        function show(bear) {
          bullBtn.setAttribute("aria-pressed", bear ? "false" : "true");
          bearBtn.setAttribute("aria-pressed", bear ? "true" : "false");
          bullList.hidden = bear;
          bearList.hidden = !bear;
          intro.textContent = bear
            ? "Txchyon Bear studies falling markets: macro liquidity, systemic risk and protecting capital."
            : bullIntro;
          all.textContent = bear ? "Visit Txchyon Bear" : bullAll;
          all.setAttribute("href", bear ? "/bear" : bullHref);
        }
        bullBtn.addEventListener("click", function () { show(false); });
        bearBtn.addEventListener("click", function () { show(true); });
      })();
    </script>
  </body>
</html>
