---
// 404. Old version: src/pages/_archive/old-design/404.astro.txt
import { getCollection } from "astro:content";
import Lab from "@/layouts/Lab.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 5);
const fmt = (x: Date | string) =>
  new Date(x).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Lab
  title="Page not found | Txchyon"
  description="This page doesn't exist. Try the blog, the search, or the home page."
  canonical="/404"
  noindex={true}
>
  <section class="lab-section first">
    <p class="small mono">404</p>
    <h1>Page not found</h1>
    <p class="lead">That page doesn't exist or has moved.</p>
    <p>
      <a class="btn" href="/">Home</a>
      <a class="btn ghost" href="/blog">Blog</a>
      <a class="btn ghost" href="/search">Search</a>
    </p>
  </section>

  <section class="lab-section tight">
    <h2>Latest articles</h2>
    <div>
      {posts.map((p) => (
        <a class="entry" href={`/blog/${p.slug}`}>
          <b>{p.data.title}</b>
          <span class="meta">{fmt(p.data.date)}</span>
        </a>
      ))}
    </div>
  </section>
</Lab>
