---
// /tags. Old version: src/pages/_archive/old-design/tags-index.astro.txt
import Lab from "@/layouts/Lab.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";

const tags = (await getTaxonomy("posts", "tags")).sort();
---

<Lab title="Tags | Txchyon" description="Browse Txchyon articles by tag." canonical="/tags">
  <section class="lab-section first">
    <h1>Tags</h1>
    <p class="lead">{tags.length} tags. For broader topics see the <a href="/categories">categories</a>.</p>
  </section>
  <section class="lab-section tight">
    <div class="chips">
      {tags.map((tag) => <a href={`/tags/${tag}`}>#{humanize(tag || "")}</a>)}
    </div>
  </section>
</Lab>
