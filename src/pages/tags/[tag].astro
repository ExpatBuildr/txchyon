---
// /tags/{tag}. Old version: src/pages/_archive/old-design/tags-tag.astro.txt
import Lab from "@/layouts/Lab.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const tags = await getTaxonomy("posts", "tags");
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = await getSinglePage("posts");
const sorted = sortByDate(taxonomyFilter(posts, "tags", tag));
const name = humanize(tag || "");
const fmt = (x: Date | string) =>
  new Date(x).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Lab
  title={`#${name} | Txchyon`}
  description={`${sorted.length} ${sorted.length === 1 ? "article" : "articles"} tagged ${name} on Txchyon.`}
  canonical={`/tags/${tag}`}
  noindex={sorted.length < 2}
>
  <section class="lab-section first">
    <p class="small mono"><a href="/tags">Tags</a> /</p>
    <h1>#{name}</h1>
    <p class="lead">{sorted.length} {sorted.length === 1 ? "article" : "articles"}.</p>
  </section>
  <section class="lab-section tight">
    <div>
      {sorted.map((p: any) => (
        <a class="entry" href={`/blog/${p.slug}`}>
          <b>{p.data.title}</b>
          <span class="desc">{p.data.description}</span>
          <span class="meta">{fmt(p.data.date)}</span>
        </a>
      ))}
    </div>
  </section>
</Lab>
