---
// /authors/galaxy. The slug stays "galaxy" so old URLs and article matching keep working; the displayed name is ExpatBuildr.
// Old version: src/pages/_archive/old-design/authors-single.astro.txt
import { getCollection, render } from "astro:content";
import Lab from "@/layouts/Lab.astro";
import { slugify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors
    .filter((a) => a.slug === "galaxy")
    .map((author) => ({ params: { single: author.slug }, props: { author } }));
}

const { author } = Astro.props;
const { Content } = await render(author);
const authorKey = slugify(author.data.title);

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .filter((p) => (p.data.authors ?? []).map((a: string) => slugify(a)).includes(authorKey))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latest = posts.slice(0, 10);
const fmt = (x: Date | string) =>
  new Date(x).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Lab
  title="ExpatBuildr | Txchyon"
  description="ExpatBuildr builds the Txchyon trading app and writes its articles."
  canonical="/authors/galaxy"
>
  <section class="lab-section first">
    <p class="small mono"><a href="/authors">Authors</a> /</p>
    <h1>ExpatBuildr</h1>
    <div class="prose"><Content /></div>
    <div class="chips">
      <a href="https://x.com/expatbuilder" target="_blank" rel="noopener noreferrer">X</a>
      <a href="https://github.com/ExpatBuildr" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </section>

  <section class="lab-section tight">
    <h2>Latest articles</h2>
    <div>
      {latest.map((p) => (
        <a class="entry" href={`/blog/${p.slug}`}>
          <b>{p.data.title}</b>
          <span class="desc">{p.data.description}</span>
          <span class="meta">{fmt(p.data.date)}</span>
        </a>
      ))}
    </div>
    <p><a href="/blog">All {posts.length} articles →</a></p>
  </section>
</Lab>
