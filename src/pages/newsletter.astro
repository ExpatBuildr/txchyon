---
// /newsletter. Old version: src/pages/_archive/old-design/newsletter.astro.txt
import Lab from "@/layouts/Lab.astro";
---

<Lab
  title="Newsletter | Txchyon"
  description="New Txchyon articles and lab notes by email. Free, and you can unsubscribe any time."
  canonical="/newsletter"
>
  <section class="lab-section first">
    <h1>Newsletter</h1>
    <p class="lead">
      New articles and lab notes by email. It's free, and you can unsubscribe any time.
    </p>
  </section>

  <section class="lab-section tight">
    <div class="card form-card">
      <div id="newsletter-form-container">
        <script async is:inline src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="d3d385b2-5ea9-4dc9-8777-e4555c834796"></script>
      </div>
    </div>
    <p class="small">
      By subscribing you agree to our <a href="/privacy">privacy policy</a>. Prefer to browse first? <a href="/blog">Read the blog</a>.
    </p>
  </section>
</Lab>

<style>
  .form-card { max-width: 520px; }
</style>
