---
import Base from "@/layouts/Base.astro";
---

<Base title="Txchyon Newsletter - Crypto Alpha & Insights" 
      description="Get exclusive DeFi insights, airdrop alerts, and crypto alpha directly to your inbox. Join our free newsletter.">
  
  <section class="min-h-screen bg-gradient-to-br from-gray-900 via-black to-blue-950 py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <div class="bg-black/40 backdrop-blur-sm rounded-3xl border border-cyan-500/30 p-8 lg:p-10">
          <div class="text-5xl mb-6">🚀</div>
          
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-6">
            Get the Free Top 5 Airdrop Guide
          </h1>
          
          <!-- FIXED LINE: Just use 400+ directly -->
          <p class="text-gray-300 text-lg mb-8">
            Join 400+ crypto builders getting exclusive airdrop strategies & insights.
            <span class="text-cyan-400 font-medium"> Zero spam. Unsubscribe anytime.</span>
          </p>
          
          <div class="space-y-6 mb-10 text-left bg-black/30 p-6 rounded-2xl">
            <div class="flex items-center gap-3">
              <span class="text-cyan-400 text-xl">📥</span>
              <div>
                <div class="text-white font-medium">Instant PDF Download</div>
                <div class="text-gray-400 text-sm">"Top 5 Airdrop Guide" sent immediately</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-cyan-400 text-xl">⚡</span>
              <div>
                <div class="text-white font-medium">Weekly Alpha</div>
                <div class="text-gray-400 text-sm">Early opportunities & actionable strategies</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-cyan-400 text-xl">🔒</span>
              <div>
                <div class="text-white font-medium">100% Free & Private</div>
                <div class="text-gray-400 text-sm">No credit card • We respect your privacy</div>
              </div>
            </div>
          </div>
          
          <!-- Custom Beehiiv Form -->
          <div class="mb-8">
            <div id="newsletter-form-container" class="max-w-md mx-auto">
              <form id="txchyon-newsletter-form" class="space-y-4">
                <input 
                  type="email" 
                  id="newsletter-email" 
                  placeholder="Enter your email" 
                  required
                  class="w-full px-6 py-4 bg-white/5 border border-cyan-500/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-all"
                />
                <button 
                  type="submit" 
                  id="newsletter-submit"
                  class="w-full py-4 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black uppercase tracking-widest rounded-xl hover:shadow-lg hover:shadow-cyan-500/20 transition-all"
                >
                  Get Access Now →
                </button>
              </form>
              <div id="newsletter-message" class="mt-4 text-sm hidden"></div>
            </div>
          </div>

          <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
              const form = document.getElementById('txchyon-newsletter-form');
              const emailInput = document.getElementById('newsletter-email');
              const submitBtn = document.getElementById('newsletter-submit');
              const message = document.getElementById('newsletter-message');

              if (form) {
                form.addEventListener('submit', async (e) => {
                  e.preventDefault();
                  const email = emailInput.value.trim();
                  
                  submitBtn.disabled = true;
                  submitBtn.textContent = 'Processing...';
                  message.className = 'mt-4 text-sm text-cyan-400';
                  message.textContent = 'Initializing synchronization...';
                  message.classList.remove('hidden');

                  try {
                    const result = await window.subscribeToBeehiiv({
                      email: email,
                      tags: ['crypto', 'newsletter_page'],
                      utm_medium: 'newsletter_page',
                      utm_campaign: 'txchyon_newsletter'
                    });

                    if (result === true || result === "already_subscribed") {
                      localStorage.setItem('txchyon_subscriber', 'true');
                      localStorage.setItem('txchyon_subscriber_email', email);
                      
                      message.className = 'mt-4 text-sm text-green-400';
                      message.textContent = '🎉 Welcome to the inner circle! Access granted.';
                      submitBtn.textContent = '✓ Subscribed';
                      
                      setTimeout(() => {
                        window.location.href = '/?subscribed=true';
                      }, 2000);
                    } else {
                      message.className = 'mt-4 text-sm text-red-400';
                      message.textContent = '❌ Subscription failed. Please try again.';
                      submitBtn.disabled = false;
                      submitBtn.textContent = 'Get Access Now →';
                    }
                  } catch (err) {
                    console.error('Newsletter error:', err);
                    message.className = 'mt-4 text-sm text-red-400';
                    message.textContent = '❌ An error occurred. Please try again.';
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Get Access Now →';
                  }
                });
              }
            });
          </script>
          
          <p class="text-gray-500 text-sm mb-10">
            By subscribing, you agree to our <a href="/privacy" class="text-cyan-400 hover:text-cyan-300">Privacy Policy</a>
          </p>
          
          <div class="mt-12 pt-8 border-t border-gray-800">
            <p class="text-gray-400 mb-4">Want to explore more first?</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/" 
                 class="px-6 py-3 border border-gray-700 text-gray-300 rounded-lg hover:bg-gray-800 transition-colors text-center">
                ← Back to Home
              </a>
              <a href="/blog" 
                 class="px-6 py-3 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors text-center">
                📚 Read Free Guides
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .beehiiv-embed-container {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 200px;
    }
    
    .beehiiv-embed iframe {
      background-color: transparent !important;
    }
    
    @media (min-width: 768px) {
      .beehiiv-embed iframe {
        max-width: 508px;
      }
    }
  </style>
</Base>